{
  "name": "k5",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:setup": "pnpm --filter @k5/web db:setup",
    "worker": "pnpm --filter @k5/web worker",
    "platform:admin": "pnpm --filter @k5/web platform:admin"
  },
  "devDependencies": {
    "turbo": "2.10.13"
  }
}
