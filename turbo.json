{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "BETTER_AUTH_TRUSTED_ORIGINS", "DATABASE_PATH", "SESSION_IDLE_SECONDS", "K5_CREDENTIALS_KEY", "K5_CREDENTIALS_PREVIOUS_KEYS", "VAULT_OCR_URL", "VAULT_OCR_TOKEN", "SENTRY_AUTH_TOKEN"],
  "globalEnv": ["SENTRY_DSN", "SENTRY_ENVIRONMENT", "SENTRY_RELEASE", "SENTRY_ENABLED", "SENTRY_TRACES_SAMPLE_RATE", "SENTRY_ORG", "SENTRY_PROJECT", "SENTRY_REQUIRE_SOURCEMAPS", "NEXT_PUBLIC_SENTRY_*"],
  "globalDependencies": ["**/.env.local", "**/.env"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**", "!.next/dev/**", "public/sw.js"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "cache": false
    }
  }
}
