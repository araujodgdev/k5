{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lume-monitoring",
  "main": "src/workers/monitoring.ts",
  "account_id": "bf552f67bcf46921dbe4137ee0ff8980",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "browser": { "binding": "BROWSER" },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "cb3229db2c05407aa00420f68bcb6f8f" }],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "lume-monitoring-evidence" }],
  "triggers": { "crons": ["*/5 * * * *", "2,17,32,47 * * * *"] },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "persist": true },
    "traces": { "enabled": true, "persist": true }
  },
  "vars": {
    "SENTRY_ENVIRONMENT": "production",
    "SENTRY_TRACES_SAMPLE_RATE": "1",
    "MONITOR_BASE_URL": "https://lume.software"
  },
  "secrets": { "required": ["MONITOR_EMAIL", "MONITOR_PASSWORD", "MONITOR_OFFICE_ID", "MONITOR_RUN_TOKEN"] }
}
