{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Google integrations Worker (docs/integracao-google.md). Not deployed by default: publishing it
  // requires the Google OAuth secrets, the Queue and an explicit `pnpm integrations:deploy`.
  "name": "lume-integrations",
  "routes": [{ "pattern": "integrations.lume.software", "custom_domain": true }],
  "account_id": "bf552f67bcf46921dbe4137ee0ff8980",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/workers/integrations.ts",
  "upload_source_maps": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "flagship": [{ "binding": "FLAGS", "app_id": "2563a30d-9bc9-45e2-a06b-fafec09b879a" }],
  // Server-only guards are for Next bundles; the Worker imports the same server modules directly.
  "alias": { "server-only": "./empty-stub.js" },
  "vars": { "SENTRY_ENVIRONMENT": "production", "SENTRY_TRACES_SAMPLE_RATE": "0.1", "VAULT_STORAGE_BACKEND": "r2" },
  "r2_buckets": [{ "binding": "VAULT", "bucket_name": "k5-vault-staging" }],
  // Same PostgreSQL as the web, with query caching disabled.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "cb3229db2c05407aa00420f68bcb6f8f" }],
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [{ "binding": "INTEGRATIONS_QUEUE", "queue": "k5-integrations-staging" }],
    "consumers": [{ "queue": "k5-integrations-staging", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 }]
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "persist": true },
    "traces": { "enabled": true, "persist": true }
  }
}
