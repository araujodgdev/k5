# Produção: https://lume.software; somente esta origem é confiável. Túneis ficam restritos ao desenvolvimento.
BETTER_AUTH_URL=http://localhost:3000
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
CLOUDFLARE_ACCOUNT_ID=
FLAGSHIP_APP_ID=
FLAGSHIP_EVALUATE_TOKEN=
# Flagship: whatsapp-integration e chatgpt-ads. Fallback false; Workers usam FLAGS.
# A chave OpenAI Ads é cadastrada por escritório na tela Anúncios BETA, não neste arquivo.
# Administração por escritório: Flagship App Read, Write e Evaluate no app do ambiente.
FLAGSHIP_MANAGE_TOKEN=
K5_WHATSAPP_REQUESTS_PER_MINUTE=60
K5_WHATSAPP_OFFICE_REQUESTS_PER_MINUTE=15
# Gerado automaticamente por pnpm db:setup em desenvolvimento.
BETTER_AUTH_SECRET=
# PostgreSQL transacional. Workers Cloudflare usam o binding HYPERDRIVE (cache desativado).
DATABASE_URL=postgresql://k5:k5-local-dev@127.0.0.1:5434/k5
# Endpoint direto, sem pool externo, usado nas migrações/importação.
DATABASE_URL_UNPOOLED=postgresql://k5:k5-local-dev@127.0.0.1:5434/k5
# Secret do Worker que inicia os Containers; URL direta com papel de leitura/escrita.
# O Hyperdrive é usado pelo web/notificações; os processadores Node usam esta URL.
# No arquivo privado .env.postgres.local, o deploy usa esta URL apenas para conferir
# o esquema. Migrações pendentes exigem DATABASE_URL_UNPOOLED administrativa válida.
PROCESSOR_DATABASE_URL=
# K5_ENV_FILE seleciona outro arquivo privado para os workers Node.
# Local: originais públicos da Pesquisa. Em staging, use o mesmo R2 do Cofre nos workers Node e web.
RESEARCH_STORAGE_PATH=.data/research-objects
# Expiração deslizante após 8 horas sem uso da sessão.
SESSION_IDLE_SECONDS=28800

# Chave independente, 32 bytes em base64. Setup gera somente em desenvolvimento.
# Guarde com segurança: sua perda impede recuperar as credenciais dos providers.
# Novas credenciais registram o identificador (hash truncado) da chave usada.
K5_CREDENTIALS_KEY=
# Rotação: defina a nova chave acima, mova a anterior para cá (várias separadas por vírgula),
# execute pnpm platform:admin rotate-key --email <administrador da plataforma> e,
# depois de testar as conexões, remova as chaves anteriores.
K5_CREDENTIALS_PREVIOUS_KEYS=
# Rotação em duas etapas: novos registros usam NEXT, mantendo KEY/PREVIOUS para leitura.
# Guarde a nova chave fora do repositório e atualize todos os runtimes antes de recifrar.
# Consulte docs/rotacao-credenciais.md antes de promover NEXT ou remover chaves antigas.
K5_CREDENTIALS_NEXT_KEY=
# TypeSafe: conexão central cadastrada na plataforma e cifrada com K5_CREDENTIALS_KEY.
# As avaliações registram escritório e pessoa, com orçamento e modos off/shadow/enabled.
# Somente a avaliação sintética opcional aceita TYPESAFE_EVAL_KEY_FILE ou TYPESAFE_API_KEY.
# Opcional: serviço confiável de OCR. POST arquivo; resposta {pages:[{page:1,text:"..."}]}.
# Fora da Cloudflare, cabeçalho de IP do cliente que o SEU proxy sobrescreve (ex.: x-real-ip).
# Vazio: o limite de login/cadastro é compartilhado por todos. Nunca aponte para um cabeçalho que o cliente controla.
K5_CLIENT_IP_HEADER=

VAULT_OCR_URL=
VAULT_OCR_TOKEN=
# Exportação PDF local: caminho do executável LibreOffice. Vazio usa soffice no Linux
# ou C:/Program Files/LibreOffice/program/soffice.exe no Windows. Containers já o incluem.
LIBREOFFICE_PATH=

# Busca na web pelo Exa (exa.ai), usada pelo Lume com modelos sem busca própria
# (Gemini, OpenRouter e outros); OpenAI e
# Anthropic usam a busca do provedor no chat. Só a consulta é enviada ao Exa.
EXA_API_KEY=

# Memória de aprendizado do Lume no Honcho (honcho.dev). Vazio desliga: vale só a memória de trabalho.
# Só as mudanças da memória de trabalho são enviadas. HONCHO_URL aponta para um self-host; vazio usa
# https://api.honcho.dev. HONCHO_ENVIRONMENT separa os workspaces de cada ambiente (padrão: SENTRY_ENVIRONMENT).
HONCHO_API_KEY=
HONCHO_URL=
HONCHO_ENVIRONMENT=

# Cloudflare Turnstile no cadastro. Só liga com as duas chaves; vazio dispensa a verificação.
# A chave do site é pública (vai para o formulário); a secreta fica só no servidor.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostnames de onde o formulário pode vir, separados por vírgula. Produção: só lume.software.
TURNSTILE_HOSTNAMES=

# Google: configuração opcional, separada do login. Veja docs/integracao-google.md.
# Use projetos/credenciais distintos para homologação e produção; nunca NEXT_PUBLIC para segredos.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Vazio usa BETTER_AUTH_URL + /api/integrations/google/callback.
GOOGLE_OAUTH_REDIRECT_URI=
# Chave pública restrita à Google Picker API e aos HTTP referrers do aplicativo.
GOOGLE_PICKER_API_KEY=
# Número (não nome) do mesmo projeto Google Cloud do cliente OAuth.
GOOGLE_PICKER_APP_ID=
# URL HTTPS pública /api/integrations/google/notify; vazio usa sincronização periódica.
GOOGLE_CALENDAR_WEBHOOK_URL=
K5_GOOGLE_USAGE_TIMEZONE=America/Sao_Paulo

# Mensagens pessoais: envio externo pelo Cloudflare Email Service, sem receber respostas.
# O domínio remetente deve estar autorizado no Email Service. Veja docs/mensagens.md.
# CLOUDFLARE_ACCOUNT_ID também é usado na avaliação do piloto do WhatsApp.
CLOUDFLARE_EMAIL_API_TOKEN=
TISES_MESSAGES_FROM=

# Plano do escritório pela AbacatePay (checkout hospedado, PIX ou cartão). Vazio desativa os pagamentos.
# A chave define o ambiente: chave de Dev mode simula pagamentos, chave de produção cobra de verdade.
# Permissões mínimas da chave: PRODUCT:CREATE, PRODUCT:READ, CUSTOMER:CREATE, CHECKOUT:CREATE, CHECKOUT:READ.
ABACATEPAY_API_KEY=
# Secret do webhook cadastrado na AbacatePay com a URL HTTPS pública
# <BETTER_AUTH_URL>/api/billing/webhook?webhookSecret=<este valor> e os eventos checkout.completed
# e checkout.refunded. Vazio desativa o webhook; a página Plano ainda confere os pagamentos pendentes.
ABACATEPAY_WEBHOOK_SECRET=
# Mensalidade em centavos (padrão 19900 = R$ 199,00). Mudar o preço cria outro produto na AbacatePay.
BILLING_PLAN_PRICE_CENTS=

# Asaas dos escritórios: cada escritório conecta a própria chave em Integrações (nada a configurar aqui).
# Ao conectar, o Lume cadastra o webhook <base>/api/asaas/webhook na conta. A base é esta variável ou,
# vazia, BETTER_AUTH_URL; precisa ser HTTPS público, senão a baixa automática fica indisponível.
ASAAS_WEBHOOK_BASE_URL=

# Web Push. Gere uma vez por ambiente com `pnpm --filter @k5/web exec web-push generate-vapid-keys`.
# A chave pública pode chegar ao navegador; a privada fica somente nos workers de envio.
K5_VAPID_KEY_ID=
K5_VAPID_SUBJECT=mailto:operacao@example.com
K5_VAPID_PUBLIC_KEY=
K5_VAPID_PRIVATE_KEY=

# Sentry: o DSN público de lume-wr/lume já está em src/lib/observability/settings.ts.
# Desenvolvimento/testes não enviam eventos por padrão. Ative ambos para validar localmente.
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Opcional: SENTRY_DSN e NEXT_PUBLIC_SENTRY_DSN sobrescrevem o destino; vazio desativa o envio.
# Release: mesmo SHA no servidor, navegador e upload dos source maps.
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
# SOMENTE BUILD: guarde SENTRY_AUTH_TOKEN em .env.sentry-build.local (ignorado pelo Git).
# Em CI: secret SENTRY_AUTH_TOKEN. SENTRY_REQUIRE_SOURCEMAPS=true falha se faltar o token.
# Replay, logs, corpos HTTP e conteúdo de IA não são coletados por padrão.
