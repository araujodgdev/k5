BETTER_AUTH_URL=http://localhost:3000
# Gerado automaticamente por pnpm db:setup em desenvolvimento.
BETTER_AUTH_SECRET=
# PostgreSQL transacional. Workers Cloudflare usam o binding HYPERDRIVE (cache desativado).
DATABASE_URL=postgresql://k5:k5-local-dev@127.0.0.1:5434/k5
# Endpoint direto, sem pool externo, usado nas migrações/importação.
DATABASE_URL_UNPOOLED=postgresql://k5:k5-local-dev@127.0.0.1:5434/k5
# Secret do Worker que inicia os Containers; URL direta com papel de leitura/escrita.
# O Hyperdrive é usado pelo web/notificações; os processadores Node usam esta URL.
PROCESSOR_DATABASE_URL=
# K5_ENV_FILE seleciona outro arquivo privado para os workers Node.
# Local: originais públicos da Pesquisa. Em staging, use o mesmo R2 do Cofre nos workers Node e web.
RESEARCH_STORAGE_PATH=.data/research-objects
# Expiração deslizante após 8 horas sem uso da sessão.
SESSION_IDLE_SECONDS=28800

# Chave independente, 32 bytes em base64. Setup gera somente em desenvolvimento.
# Guarde com segurança: sua perda impede recuperar as credenciais dos providers.
# Novas credenciais registram o identificador (hash truncado) da chave usada.
K5_CREDENTIALS_KEY=
# Rotação: defina a nova chave acima, mova a anterior para cá (várias separadas por vírgula),
# execute pnpm platform:admin rotate-key --email <administrador da plataforma> e,
# depois de testar as conexões, remova as chaves anteriores.
K5_CREDENTIALS_PREVIOUS_KEYS=
# Rotação em duas etapas: novos registros usam NEXT, mantendo KEY/PREVIOUS para leitura.
# Guarde a nova chave fora do repositório e atualize todos os runtimes antes de recifrar.
# Consulte docs/rotacao-credenciais.md antes de promover NEXT ou remover chaves antigas.
K5_CREDENTIALS_NEXT_KEY=
# TypeSafe: chave individual por escritório, cadastrada na plataforma e cifrada
# com K5_CREDENTIALS_KEY. Não configure uma chave global para tráfego de produção.
# Somente a avaliação sintética opcional aceita TYPESAFE_EVAL_KEY_FILE ou TYPESAFE_API_KEY.
# Opcional: serviço confiável de OCR. POST arquivo; resposta {pages:[{page:1,text:"..."}]}.
# Fora da Cloudflare, cabeçalho de IP do cliente que o SEU proxy sobrescreve (ex.: x-real-ip).
# Vazio: o limite de login/cadastro é compartilhado por todos. Nunca aponte para um cabeçalho que o cliente controla.
K5_CLIENT_IP_HEADER=

VAULT_OCR_URL=
VAULT_OCR_TOKEN=

# Google: configuração opcional, separada do login. Veja docs/integracao-google.md.
# Use projetos/credenciais distintos para homologação e produção; nunca NEXT_PUBLIC para segredos.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Vazio usa BETTER_AUTH_URL + /api/integrations/google/callback.
GOOGLE_OAUTH_REDIRECT_URI=
# Chave pública restrita à Google Picker API e aos HTTP referrers do aplicativo.
GOOGLE_PICKER_API_KEY=
# Número (não nome) do mesmo projeto Google Cloud do cliente OAuth.
GOOGLE_PICKER_APP_ID=
# URL HTTPS pública /api/integrations/google/notify; vazio usa sincronização periódica.
GOOGLE_CALENDAR_WEBHOOK_URL=
K5_GOOGLE_USAGE_TIMEZONE=America/Sao_Paulo

# Web Push. Gere uma vez por ambiente com `pnpm --filter @k5/web exec web-push generate-vapid-keys`.
# A chave pública pode chegar ao navegador; a privada fica somente nos workers de envio.
K5_VAPID_KEY_ID=
K5_VAPID_SUBJECT=mailto:operacao@example.com
K5_VAPID_PUBLIC_KEY=
K5_VAPID_PRIVATE_KEY=

# Sentry: o DSN público de lume-wr/lume já está em src/lib/observability/settings.ts.
# Desenvolvimento/testes não enviam eventos por padrão. Ative ambos para validar localmente.
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Opcional: SENTRY_DSN e NEXT_PUBLIC_SENTRY_DSN sobrescrevem o destino; vazio desativa o envio.
# Release: mesmo SHA no servidor, navegador e upload dos source maps.
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
# SOMENTE BUILD: guarde SENTRY_AUTH_TOKEN em .env.sentry-build.local (ignorado pelo Git).
# Em CI: secret SENTRY_AUTH_TOKEN. SENTRY_REQUIRE_SOURCEMAPS=true falha se faltar o token.
# Replay, logs, corpos HTTP e conteúdo de IA não são coletados por padrão.
