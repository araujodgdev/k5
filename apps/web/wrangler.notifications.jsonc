{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "k5-notifications-staging",
  "account_id": "bf552f67bcf46921dbe4137ee0ff8980",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/workers/notifications.ts",
  "upload_source_maps": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": { "SENTRY_ENVIRONMENT": "staging", "SENTRY_TRACES_SAMPLE_RATE": "0.1" },
  // Same PostgreSQL as the web, with query caching disabled.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "cb3229db2c05407aa00420f68bcb6f8f" }],
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [{ "binding": "NOTIFICATION_QUEUE", "queue": "k5-notifications-staging" }],
    "consumers": [{ "queue": "k5-notifications-staging", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 }]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "persist": true },
    "traces": { "enabled": true, "persist": true }
  }
}
