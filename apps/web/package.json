{
  "name": "@k5/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:setup && next dev",
    "build": "tsx scripts/generate-service-worker.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:setup": "tsx scripts/setup.ts",
    "test": "tsx scripts/test-postgres.ts",
    "typesafe:eval": "node --conditions=react-server --import tsx scripts/typesafe-eval.ts",
    "worker": "node --conditions=react-server --import tsx scripts/worker.ts",
    "judicial:worker": "node --conditions=react-server --import tsx scripts/judicial-worker.ts",
    "notifications:worker": "node --conditions=react-server --import tsx scripts/notification-worker.ts",
    "notifications:build": "tsx scripts/build-notifications.ts",
    "notifications:deploy": "tsx scripts/build-notifications.ts --deploy",
    "judicial:admin": "node --conditions=react-server --import tsx scripts/judicial-admin.ts",
    "platform:admin": "tsx scripts/platform-admin.ts",
    "sentry:verify": "tsx scripts/verify-sentry.ts",
    "sentry:verify:browser": "tsx scripts/verify-sentry-browser.ts",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "tsx scripts/generate-service-worker.ts && vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "tsx scripts/generate-service-worker.ts && tsx scripts/deploy-cloudflare.ts",
    "db:migrate": "tsx scripts/migrate-postgres.ts",
    "db:import": "tsx scripts/import-legacy-database.ts",
    "db:local": "tsx scripts/postgres-local.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.105",
    "@assistant-ui/ai-sdk": "^0.0.6",
    "@assistant-ui/react": "^0.15.20",
    "@aws-sdk/client-s3": "^3.1134.0",
    "@cloudflare/containers": "^0.3.7",
    "@gsap/react": "^2.1.2",
    "@js-temporal/polyfill": "^0.5.1",
    "@mastra/ai-sdk": "^1.10.3",
    "@mastra/core": "^1.67.0",
    "@mmmike/web-push": "^1.3.0",
    "@napi-rs/canvas": "^1.0.9",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/cloudflare": "^10.75.0",
    "@sentry/core": "^10.75.0",
    "@sentry/nextjs": "^10.75.0",
    "@sentry/node": "^10.75.0",
    "@sentry/react": "^10.75.0",
    "@typesafe-ai/sdk": "0.6.0",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "ai": "^7.0.102",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "docx": "^9.7.1",
    "docxtemplater": "^3.70.0",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.46.0",
    "mailparser": "^3.9.28",
    "mammoth": "^1.12.3",
    "marked": "^18.0.13",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "pizzip": "^3.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "vinext": "1.0.0-beta.10",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@playwright/test": "^1.63.0",
    "@sentry/cli": "^3.8.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  },
  "packageManager": "pnpm@12.4.2",
  "type": "module"
}
