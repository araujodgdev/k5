# Root environment for docker compose. Copy to .env and fill in before `docker compose up`.
# The application's own variables live in apps/web/.env.example for non-Docker development.
# Docker fixes RESEARCH_STORAGE_PATH to /data/research-objects in the shared appdata volume.

# openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# openssl rand -base64 32 - losing this makes stored provider credentials unrecoverable.
K5_CREDENTIALS_KEY=
K5_CREDENTIALS_PREVIOUS_KEYS=

SESSION_IDLE_SECONDS=28800

# Banco transacional PostgreSQL local.
POSTGRES_PASSWORD=k5-local-dev
POSTGRES_PORT=5434

# Local vector index (pgvector container). Staging points these at Neon instead.
VECTOR_DB_PASSWORD=k5-local-dev
VECTOR_DB_PORT=5433

WEB_PORT=3000
ADMINER_PORT=8080

# Optional trusted OCR service.
VAULT_OCR_URL=
VAULT_OCR_TOKEN=

# Sentry já aponta para lume-wr/lume. Docker local começa sem envio de telemetria.
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
# Para source maps no Docker use BuildKit --secret id=sentry_auth_token,env=SENTRY_AUTH_TOKEN.
# Nunca passe SENTRY_AUTH_TOKEN como build arg ou variável NEXT_PUBLIC_*.
